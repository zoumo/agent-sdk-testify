+// Adapt the pipe framing to the messages consumed by the existing worker.
+trait RemoteTransport: Send {
+    fn next(&mut self) -> impl Future<Output = Option<Result<Message, TungsteniteError>>> + Send;
+    fn send_text(
+        &mut self,
+        text: String,
+    ) -> impl Future<Output = Result<(), TungsteniteError>> + Send;
+    fn close(&mut self) -> impl Future<Output = Result<(), TungsteniteError>> + Send;
+}
+
+impl<S: AsyncRead + AsyncWrite + Unpin + Send> RemoteTransport for RemoteWebSocket<S> {
+    async fn next(&mut self) -> Option<Result<Message, TungsteniteError>> {
+        Self::next(self).await
+    }
+
+    async fn send_text(&mut self, text: String) -> Result<(), TungsteniteError> {
+        Self::send_text(self, text).await
+    }
+
+    async fn close(&mut self) -> Result<(), TungsteniteError> {
+        Self::close(self).await
+    }
+}
+
+struct StdioTransport {
+    stdin: Option<ChildStdin>,
+    stdout: FramedRead<ChildStdout, LinesCodec>,
+}
+
+impl RemoteTransport for StdioTransport {
+    async fn next(&mut self) -> Option<Result<Message, TungsteniteError>> {
+        self.stdout.next().await.map(|line| {
+            line.map(|text| Message::Text(text.into()))
+                .map_err(|err| TungsteniteError::Io(IoError::new(ErrorKind::InvalidData, err)))
+        })
+    }
+
+    async fn send_text(&mut self, mut text: String) -> Result<(), TungsteniteError> {
+        let stdin = self.stdin.as_mut().ok_or(TungsteniteError::AlreadyClosed)?;
+        text.push('\n');
+        stdin
+            .write_all(text.as_bytes())
+            .await
+            .map_err(TungsteniteError::Io)
+    }
+
+    async fn close(&mut self) -> Result<(), TungsteniteError> {
+        drop(self.stdin.take());
+        Ok(())
+    }
+}
