  "cards": [
    {
      "dot": "cyan",
      "title": "工具只有三个业务入口",
      "items": [
        "record 负责真实录制；verify 负责官方 SDK 验证。",
        "mock 负责提供录制对端，复用严格协议引擎。",
        "旧 replay 改为 verify；不保留工具 simulate 或 corpus 顶层命令。"
      ]
    },
    {
      "dot": "violet",
      "title": "simulate 明确留在 agent-sdk-go",
      "items": [
        "SDK 拥有 Go driver、测试推进、并行、取消和业务报告。",
        "SDK 按工具 case 验收，用 mock 对接真实 Go SDK。",
        "工具不启动 Go driver；MASS 同样使用自己的测试入口。"
      ]
    },
    {
      "dot": "amber",
      "title": "环境先准备，再启动 SDK 宿主",
      "items": [
        "mock 查询、prepare、run、finish 是 mock 的配套模式。",
        "工具返回 workspace、env、launcher 与每连接入口。",
        "消费者应用 CODEX_HOME / CLAUDE_CONFIG_DIR；子进程不能修改父进程。"
      ]
    },
    {
      "dot": "emerald",
      "title": "verify 与 mock 收尾是两件事",
      "items": [
        "verify 只验证录制：官方业务、匹配、完整消费、EOF 与清理。",
        "mock finish 在消费者关闭 Session 后核验所有回执并清理工具资源。",
        "消费者自己断言业务并关闭服务；三者全部通过才算测试通过。"
      ]
    },
    {
      "dot": "rose",
      "title": "材料保存与设计状态",
      "items": [
        "case、官方 driver、录制库及固定索引均归工具仓库。",
        "完整私有原件在 Git 外归档；发布材料保留来源及原字节。",
        "本图为待审批目标；未迁移代码，不代表命令已实现。"
      ]
    }
