  "cards": [
    {
      "dot": "cyan",
      "title": "里程碑 A：先独立工具",
      "items": [
        "case、binding、官方录制 driver、材料和索引迁入本仓库。",
        "录制及官方回放在本仓库执行，Go SDK 不作为上游。",
        "Go SDK 只保留操作适配、业务断言和 mock 消费测试。"
      ]
    },
    {
      "dot": "violet",
      "title": "里程碑 B：内置场景与下游使用",
      "items": [
        "本图为目标设计，新增命令尚未实现。",
        "内置集合由本仓库的 case、索引和合格材料生成。",
        "SDK 与 MASS 共用准备、匹配和回执；MASS 无需 driver。"
      ]
    },
    {
      "dot": "amber",
      "title": "环境需要配置给 SDK 宿主",
      "items": [
        "Codex：HOME、CODEX_HOME、tmp 与必要历史。",
        "Claude：CLAUDE_CONFIG_DIR、workspace 与派生历史。",
        "mock 子进程不能修改父进程；调用方在启动宿主前应用配置。"
      ]
    },
    {
      "dot": "emerald",
      "title": "成功与结束分别核验",
      "items": [
        "调用方断言业务，并先关闭自己的 Session / Runtime。",
        "verify 检查所有连接的严格匹配、完整消费、EOF 和退出。",
        "cleanup 清理工具自有目录；业务服务由调用方关闭。"
      ]
    },
    {
      "dot": "rose",
      "title": "材料和证据的边界",
      "items": [
        "原件由本工具管理，私有采集包在 Git 外保留。",
        "审核采用录制及索引在本仓库维护，发布集合随版本内置。",
        "运行资源清理，报告保留；完整覆盖缺口仍须报告。"
      ]
    }
  ]
