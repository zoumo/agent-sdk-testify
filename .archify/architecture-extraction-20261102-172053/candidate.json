    {
      "dot": "cyan",
      "title": "里程碑 A：先独立工具",
      "items": [
        "工具迁入新 module；不导入 SDK 或其 fixture。",
        "Go / 官方 driver、完整 case 与固定索引留在 SDK。",
        "SDK 固定外部二进制；工具自测使用自有合成材料。"
      ]
    },
    {
      "dot": "violet",
      "title": "里程碑 B：内置场景与下游使用",
      "items": [
        "本图为目标设计，新增命令尚未实现。",
        "SDK simulate 与 MASS 共用准备、匹配和回执实现。",
        "MASS 无需 driver；测试读取 prepare 返回的环境与入口。"
      ]
    },
    {
      "dot": "amber",
      "title": "环境需要配置给 SDK 宿主",
      "items": [
        "Codex：HOME、CODEX_HOME、tmp 与必要历史。",
        "Claude：CLAUDE_CONFIG_DIR、workspace 与派生历史。",
        "mock 子进程不能修改父进程；调用方在启动宿主前应用配置。"
      ]
    },
    {
      "dot": "emerald",
      "title": "成功与结束分别核验",
      "items": [
        "调用方断言业务，并先关闭自己的 Session / Runtime。",
        "verify 检查所有连接的严格匹配、完整消费、EOF 和退出。",
        "cleanup 清理工具自有目录；业务服务由调用方关闭。"
      ]
    },
    {
      "dot": "rose",
      "title": "材料和证据的边界",
      "items": [
        "私有原件保持原字节；仅合格发布集合进入二进制。",
        "运行目录结束后清理，报告与失败证据独立保留。",
        "内置成功子集不抵扣 SDK required 缺口；不兼容材料不放宽匹配。"
      ]
    }
  ]
